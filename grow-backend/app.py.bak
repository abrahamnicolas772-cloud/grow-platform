             ]),
             passing_score=70)
        
        # Module 2
        m2 = Module(title='Module 2: Hooks Avancés', course_id=course1.id, order=2)
        db.session.add(m2)
        db.session.commit()
        
        Lesson(title='useEffect en détail', 
               content='<h2>useEffect</h2><pre>useEffect(() => {\n  document.title = `Compteur: ${count}`;\n}, [count]);</pre>',
               module_id=m2.id, order=1, duration=20)
        Lesson(title='useContext', 
               content='<h2>useContext</h2><pre>const theme = useContext(ThemeContext);</pre>',
               module_id=m2.id, order=2, duration=15)
        
        Quiz(module_id=m2.id,
             questions=json.dumps([
                 {'question': 'useEffect sert à ?', 'options': ['État local', 'Effets de bord', 'Rendu'], 'correct': 'Effets de bord'},
                 {'question': 'useContext résout ?', 'options': ['Prop drilling', 'Performance', 'Styling'], 'correct': 'Prop drilling'}
             ]),
             passing_score=70)
        
        # Cours 2: UX/UI Design
        course2 = Course(
            title='UX/UI Design Masterclass',
