{
  "version": 2,
  "builds": [
    {
      "src": "grow-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build",
        "buildCommand": "cd grow-frontend && npm install --legacy-peer-deps && npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/grow-frontend/build/$1"
    }
  ]
}
